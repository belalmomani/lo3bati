{
 "version": 1,
 "name": "gallery",
 "designWidth": 1600,
 "designHeight": 900,
 "theme": {
  "preset": "jelly"
 },
 "root": {
  "id": "root",
  "type": "Panel",
  "anchor": "stretch",
